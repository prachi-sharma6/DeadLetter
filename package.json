{
  "name": "deadletter",
  "version": "0.1.0",
  "private": true,
  "description": "DeadLetter: monitor, inspect and recover failed background jobs",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "concurrently -k -n api,worker,web -c blue,magenta,green \"npm:dev:api\" \"npm:dev:worker\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @deadletter/api",
    "dev:worker": "npm run dev -w @deadletter/worker",
    "dev:web": "npm run dev -w @deadletter/web",
    "build": "npm run db:generate && npm run build -w @deadletter/web && npm run build -w @deadletter/api && npm run build -w @deadletter/worker",
    "start:api": "node apps/api/dist/server.js",
    "start:worker": "node apps/worker/dist/main.js",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --project unit --coverage",
    "db:generate": "npm run generate -w @deadletter/db",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "db:migrate": "npm run migrate:dev -w @deadletter/db",
    "db:deploy": "npm run migrate:deploy -w @deadletter/db",
    "db:migrate:test": "npm run migrate:test -w @deadletter/db"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.10",
    "@vitest/coverage-v8": "5.1.2",
    "concurrently": "10.0.7",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.2",
    "pino-pretty": "13.2.0",
    "prettier": "3.10.1",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html}": "prettier --write"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "msgpackr-extract": false
  },
  "overrides": {
    "effect": "3.22.5"
  }
}
