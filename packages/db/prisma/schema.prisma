// DeadLetter schema v2. Conventions (docs/adr/0010-data-model.md):
//  - ids are time-ordered UUIDv7 stored as native uuid
//  - every timestamp is timestamptz (UTC on the wire, converted for display in the UI)
//  - tenant boundary: Organization -> Project; every job-domain row carries projectId
//  - append-only history: JobAttempt and JobEvent rows are never updated after they are finished/written
//  - Job.version is bumped on every update and checked in WHERE clauses (optimistic concurrency)
// The connection URL lives in prisma.config.ts (Prisma 7).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── enums ─────────────────────────────

enum Plan {
  FREE
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum EmailTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

/// How DeadLetter re-runs a job for retry/replay (docs/adr/0006).
enum RecoveryMode {
  PULL // the customer's SDK agent long-polls for commands
  PUSH // DeadLetter POSTs to the project's signed webhook
}

enum JobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  RETRYING
  DEAD_LETTER
  CANCELLED
}

enum JobMode {
  REPORTED // the customer's app runs the job and reports what happened
  MANAGED // DeadLetter dispatches every attempt (push or pull)
}

enum AttemptStatus {
  RUNNING
  SUCCEEDED
  FAILED
  ABANDONED // the worker/agent running it disappeared
}

enum AttemptTrigger {
  INITIAL
  AUTO_RETRY
  MANUAL_RETRY
  REPLAY
}

enum BackoffStrategy {
  EXPONENTIAL
  LINEAR
  FIXED
}

enum JitterMode {
  NONE
  FULL
  EQUAL
}

enum RecoveryKind {
  RETRY
  REPLAY
  CANCEL
}

enum RecoveryStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum IdempotencyState {
  IN_PROGRESS
  COMPLETED
}

enum AlertType {
  CRITICAL_FAILURE
  REPEATED_FAILURE
  RETRY_EXHAUSTION
  QUEUE_BACKLOG
  WORKER_HEALTH
  ERROR_RATE
  RECOVERY_COMPLETE
}

enum Severity {
  INFO
  WARNING
  CRITICAL
}

enum AlertChannel {
  IN_APP
  EMAIL
  SLACK
}

enum DeliveryStatus {
  SENT
  FAILED
  NOT_CONFIGURED
  SUPPRESSED // dropped by a quota or de-duplication
}

// ───────────────────────────── identity & tenancy ─────────────────────────────

model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  /// stored lower-cased; uniqueness is case-insensitive by construction
  email           String    @unique
  name            String
  passwordHash    String
  emailVerifiedAt DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  memberships Membership[]
  sessions    Session[]
  emailTokens EmailToken[]
}

/// Server-side sessions: the cookie holds a random token, the database only its SHA-256 hash.
model Session {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime  @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailToken {
  id        String            @id @default(uuid(7)) @db.Uuid
  userId    String            @db.Uuid
  purpose   EmailTokenPurpose
  tokenHash String            @unique
  expiresAt DateTime          @db.Timestamptz(3)
  usedAt    DateTime?         @db.Timestamptz(3)
  createdAt DateTime          @default(now()) @db.Timestamptz(3)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

model Organization {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  slug      String   @unique
  plan      Plan     @default(FREE)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  memberships Membership[]
  invites     Invite[]
  projects    Project[]
  auditLogs   AuditLog[]
}

model Membership {
  id        String       @id @default(uuid(7)) @db.Uuid
  orgId     String       @db.Uuid
  userId    String       @db.Uuid
  role      MemberRole
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
}

model Invite {
  id          String       @id @default(uuid(7)) @db.Uuid
  orgId       String       @db.Uuid
  email       String
  role        MemberRole
  tokenHash   String       @unique
  invitedById String?      @db.Uuid
  expiresAt   DateTime     @db.Timestamptz(3)
  acceptedAt  DateTime?    @db.Timestamptz(3)
  revokedAt   DateTime?    @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([email])
}

model Project {
  id                     String       @id @default(uuid(7)) @db.Uuid
  orgId                  String       @db.Uuid
  name                   String
  slug                   String
  description            String       @default("")
  recoveryMode           RecoveryMode @default(PULL)
  webhookUrl             String?
  /// AES-256-GCM ciphertext (packages/core crypto); never stored or logged in clear text
  webhookSecretEnc       String?
  redactKeys             String[]     @default([])
  replayCompletedAllowed Boolean      @default(false)
  createdAt              DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime     @updatedAt @db.Timestamptz(3)

  org           Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  apiKeys       ApiKey[]
  queues        Queue[]
  jobs          Job[]
  retryPolicies RetryPolicy[]
  recoveries    RecoveryOperation[]
  errorGroups   ErrorGroup[]
  alertRules    AlertRule[]
  notifications Notification[]

  @@unique([orgId, slug])
}

/// Format `dl_live_<12 hex>_<secret>`; only the SHA-256 of the full key is stored, the prefix is public.
model ApiKey {
  id          String    @id @default(uuid(7)) @db.Uuid
  projectId   String    @db.Uuid
  name        String
  prefix      String    @unique
  keyHash     String
  scopes      String[]
  createdById String?   @db.Uuid
  lastUsedAt  DateTime? @db.Timestamptz(3)
  expiresAt   DateTime? @db.Timestamptz(3)
  revokedAt   DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// ───────────────────────────── jobs ─────────────────────────────

model Queue {
  id          String   @id @default(uuid(7)) @db.Uuid
  projectId   String   @db.Uuid
  name        String
  paused      Boolean  @default(false)
  /// max attempts of this queue executing at once (per project, enforced by the worker)
  concurrency Int      @default(5)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  jobs        Job[]

  @@unique([projectId, name])
}

model Job {
  id               String    @id @default(uuid(7)) @db.Uuid
  projectId        String    @db.Uuid
  queueId          String    @db.Uuid
  /// the customer's own id; unique per project, makes registration idempotent
  externalId       String
  name             String
  type             String
  status           JobStatus @default(QUEUED)
  mode             JobMode   @default(REPORTED)
  /// optimistic-concurrency counter, incremented by every update
  version          Int       @default(0)
  attemptCount     Int       @default(0)
  maxAttempts      Int
  priority         Int       @default(0)
  metadata         Json      @default("{}")
  errorGroupId     String?   @db.Uuid
  lastErrorType    String?
  lastErrorMessage String?
  lastDurationMs   Int?
  /// when the next attempt is due (scheduled retry or delayed first run)
  nextAttemptAt    DateTime? @db.Timestamptz(3)
  firstStartedAt   DateTime? @db.Timestamptz(3)
  lastStartedAt    DateTime? @db.Timestamptz(3)
  finishedAt       DateTime? @db.Timestamptz(3)
  /// enqueue -> first start, for queue-wait analytics
  waitMs           Int?
  replayOfId       String?   @db.Uuid
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)

  project    Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  queue      Queue               @relation(fields: [queueId], references: [id], onDelete: Restrict)
  errorGroup ErrorGroup?         @relation(fields: [errorGroupId], references: [id], onDelete: SetNull)
  replayOf   Job?                @relation("Replays", fields: [replayOfId], references: [id], onDelete: SetNull)
  replays    Job[]               @relation("Replays")
  payload    JobPayload?
  attempts   JobAttempt[]
  events     JobEvent[]
  recoveries RecoveryOperation[]

  @@unique([projectId, externalId])
  @@index([projectId, createdAt(sort: Desc)])
  @@index([projectId, status, createdAt(sort: Desc)])
  @@index([queueId, status])
  @@index([projectId, type])
  @@index([errorGroupId])
  @@index([status, nextAttemptAt])
  @@index([replayOfId])
}

/// Kept apart from Job so list queries never load large JSON.
model JobPayload {
  jobId     String @id @db.Uuid
  data      Json
  sizeBytes Int
  /// SHA-256 of the canonical JSON; detects content conflicts on re-registration
  sha256    String
  result    Json?
  job       Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model JobAttempt {
  id            String         @id @default(uuid(7)) @db.Uuid
  jobId         String         @db.Uuid
  attemptNumber Int
  status        AttemptStatus  @default(RUNNING)
  trigger       AttemptTrigger
  startedAt     DateTime       @default(now()) @db.Timestamptz(3)
  finishedAt    DateTime?      @db.Timestamptz(3)
  durationMs    Int?
  workerId      String?
  errorType     String?
  errorMessage  String?
  stack         String?
  errorGroupId  String?        @db.Uuid
  /// delay chosen for the next attempt when this one failed
  retryDelayMs  Int?
  recoveryOpId  String?        @db.Uuid
  job           Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  errorGroup    ErrorGroup?    @relation(fields: [errorGroupId], references: [id], onDelete: SetNull)

  @@unique([jobId, attemptNumber])
  @@index([errorGroupId, finishedAt])
  @@index([finishedAt])
}

model JobEvent {
  id            String   @id @default(uuid(7)) @db.Uuid
  jobId         String   @db.Uuid
  projectId     String   @db.Uuid
  /// job.created, attempt.started, attempt.failed, retry.scheduled, job.dead_lettered, recovery.retry, custom.*, …
  type          String
  message       String
  data          Json?
  attemptNumber Int?
  /// user:<id>, apikey:<prefix>, worker:<id>, system
  actor         String
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  job           Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
  @@index([projectId, createdAt(sort: Desc)])
}

// ───────────────────────────── recovery ─────────────────────────────

model RetryPolicy {
  id                 String                @id @default(uuid(7)) @db.Uuid
  projectId          String                @db.Uuid
  name               String
  queueName          String?
  jobType            String?
  maxAttempts        Int
  initialDelayMs     Int
  maxDelayMs         Int
  backoff            BackoffStrategy       @default(EXPONENTIAL)
  jitter             JitterMode            @default(NONE)
  retryableErrors    String[]              @default([])
  nonRetryableErrors String[]              @default([])
  priority           Int                   @default(0)
  enabled            Boolean               @default(true)
  version            Int                   @default(1)
  createdAt          DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime              @updatedAt @db.Timestamptz(3)
  project            Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revisions          RetryPolicyRevision[]

  @@index([projectId, enabled])
}

/// Immutable history of every policy change.
model RetryPolicyRevision {
  id        String      @id @default(uuid(7)) @db.Uuid
  policyId  String      @db.Uuid
  version   Int
  action    String
  snapshot  Json
  actor     String
  createdAt DateTime    @default(now()) @db.Timestamptz(3)
  policy    RetryPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId, version])
}

/// Ledger of manual recovery requests. The idempotency key makes double-submits collapse into one operation.
model RecoveryOperation {
  id             String         @id @default(uuid(7)) @db.Uuid
  projectId      String         @db.Uuid
  jobId          String         @db.Uuid
  kind           RecoveryKind
  status         RecoveryStatus @default(PENDING)
  idempotencyKey String
  actor          String
  note           String?
  /// attempt this operation produced (retry) or the new job it created (replay)
  attemptNumber  Int?
  resultJobId    String?        @db.Uuid
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  finishedAt     DateTime?      @db.Timestamptz(3)
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  job            Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([projectId, idempotencyKey])
  @@index([jobId])
}

// ───────────────────────────── reliability plumbing ─────────────────────────────

/// Transactional outbox: rows are written in the same transaction as the state change that needs queue work, then
/// moved to BullMQ by the dispatcher. Nothing is lost if Redis is down or the process crashes in between.
model OutboxMessage {
  /// monotonically increasing, gives dispatch order
  id           BigInt    @id @default(autoincrement())
  topic        String
  payload      Json
  /// becomes the BullMQ job id, so re-dispatching the same message is a no-op
  dedupeKey    String    @unique
  availableAt  DateTime  @default(now()) @db.Timestamptz(3)
  attempts     Int       @default(0)
  lastError    String?
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  dispatchedAt DateTime? @db.Timestamptz(3)

  /// pending rows are found via (dispatchedAt IS NULL, id order); dispatched rows are pruned by retention
  @@index([dispatchedAt, id])
}

/// Stored responses for Idempotency-Key requests. IN_PROGRESS rows reserve the key while the request runs.
model IdempotencyRecord {
  id          String           @id @default(uuid(7)) @db.Uuid
  projectId   String           @db.Uuid
  key         String
  requestHash String
  state       IdempotencyState @default(IN_PROGRESS)
  statusCode  Int?
  response    Json?
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  expiresAt   DateTime         @db.Timestamptz(3)

  @@unique([projectId, key])
  @@index([expiresAt])
}

/// Per-project, per-UTC-day usage counters for plan quotas.
model UsageCounter {
  projectId   String   @db.Uuid
  day         DateTime @db.Date
  jobsCreated Int      @default(0)

  @@id([projectId, day])
}

// ───────────────────────────── observability ─────────────────────────────

model ErrorGroup {
  id                String       @id @default(uuid(7)) @db.Uuid
  projectId         String       @db.Uuid
  /// sha256(errorType, normalized message, stack signature, job type, queue)
  fingerprint       String
  title             String
  errorType         String
  normalizedMessage String
  stackSignature    String
  jobType           String
  queueName         String
  sampleMessage     String
  sampleStack       String?
  occurrences       Int          @default(0)
  firstSeenAt       DateTime     @default(now()) @db.Timestamptz(3)
  lastSeenAt        DateTime     @default(now()) @db.Timestamptz(3)
  project           Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  jobs              Job[]
  attempts          JobAttempt[]

  @@unique([projectId, fingerprint])
  @@index([projectId, lastSeenAt(sort: Desc)])
}

/// Per-minute rollup so dashboards never scan raw jobs. Maintained incrementally (Phase 6).
model JobStatsMinute {
  projectId     String   @db.Uuid
  bucket        DateTime @db.Timestamptz(3)
  queueName     String
  jobType       String
  created       Int      @default(0)
  succeeded     Int      @default(0)
  failed        Int      @default(0)
  retried       Int      @default(0)
  deadLettered  Int      @default(0)
  durationMsSum BigInt   @default(0)
  durationCount Int      @default(0)

  @@id([projectId, bucket, queueName, jobType])
  @@index([projectId, bucket])
}

model AlertRule {
  id              String          @id @default(uuid(7)) @db.Uuid
  projectId       String          @db.Uuid
  name            String
  type            AlertType
  severity        Severity        @default(WARNING)
  channels        AlertChannel[]  @default([IN_APP])
  queueName       String?
  jobType         String?
  threshold       Int
  windowMinutes   Int
  cooldownMinutes Int
  recipients      String[]        @default([])
  enabled         Boolean         @default(true)
  lastTriggeredAt DateTime?       @db.Timestamptz(3)
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deliveries      AlertDelivery[]

  @@index([projectId, enabled])
}

model AlertDelivery {
  id        String         @id @default(uuid(7)) @db.Uuid
  ruleId    String?        @db.Uuid
  projectId String         @db.Uuid
  channel   AlertChannel
  status    DeliveryStatus
  severity  Severity
  title     String
  message   String
  dedupeKey String
  error     String?
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  rule      AlertRule?     @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@unique([ruleId, dedupeKey, channel])
  @@index([projectId, createdAt(sort: Desc)])
}

model Notification {
  id        String    @id @default(uuid(7)) @db.Uuid
  projectId String    @db.Uuid
  /// null = visible to every member of the project's organization
  userId    String?   @db.Uuid
  title     String
  body      String
  severity  Severity  @default(INFO)
  link      String?
  readAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt(sort: Desc)])
}

/// Who did what. Metadata is redacted before it is written; raw keys, passwords and payloads never appear here.
model AuditLog {
  id         String        @id @default(uuid(7)) @db.Uuid
  orgId      String?       @db.Uuid
  projectId  String?       @db.Uuid
  actor      String
  action     String
  targetType String?
  targetId   String?
  result     String        @default("SUCCESS")
  metadata   Json?
  requestId  String?
  ip         String?
  createdAt  DateTime      @default(now()) @db.Timestamptz(3)
  org        Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt(sort: Desc)])
  @@index([projectId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
}
