# Copy to .env (development) and .env.test (tests). Placeholders only; never commit real values.
NODE_ENV=development
LOG_LEVEL=info
LOG_PRETTY=true

DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/dl_dev
REDIS_URL=redis://localhost:6379/0

# Public origin users open in the browser (production: https://app.your-domain.com)
APP_ORIGIN=http://localhost:5173
PORT=4000
TRUST_PROXY=0

# Email (optional). Without a key, development logs emails and production reports email as not configured.
# The sender domain must be verified in Resend to email anyone other than yourself.
RESEND_API_KEY=
EMAIL_FROM="DeadLetter <noreply@your-domain.com>"
